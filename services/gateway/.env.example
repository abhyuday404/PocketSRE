GATEWAY_PORT=4100
GATEWAY_HOST=127.0.0.1
GATEWAY_ACCESS_TOKEN=
POCKETSRE_MODE=demo
DEMO_SERVICE_URL=http://127.0.0.1:4200
AUDIT_PATH=.pocketsre-data/actions.json
INCIDENT_PATH=.pocketsre-data/incidents.json

# Live mode requires a health endpoint returning ServiceHealthSchema.
HEALTH_URL=
HEALTH_SERVICE_ID=
HEALTH_SERVICE_NAME=
HEALTH_TOKEN=
# Maximum age of a normalized health observation (milliseconds).
HEALTH_MAX_AGE_MS=60000

# Read-only live connectors. Keep provider tokens on the gateway.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
# Optional reviewed fixes. Supply the credential through the process environment
# or a private environment file outside the repository. Restrict it to this repo.
# GITHUB_FIX_TOKEN requires Contents: write and Pull requests: write.
GITHUB_FIX_PATHS=
# Local development alternative: use an already authenticated gh CLI session.
GITHUB_USE_CLI=0
# Multi-project repository selection (requires GATEWAY_ACCESS_TOKEN).
# Register a GitHub App, enable device flow, and install it on selected repos.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
# Alternative: supply GITHUB_PROJECTS_TOKEN via the process environment or a
# private file OUTSIDE this repository. Metadata: read for discovery;
# Contents: read is also required for the project agent's source snapshots.
# Optional GITHUB_PROJECT_FIX_TOKEN: separate Contents: write + Pull requests:
# write credential, restricted to repositories where PR creation is intended.
PROJECTS_PATH=.pocketsre-data/projects
# Explicit trusted health origins, e.g. https://my-service.example
# No wildcards, credentials, query strings, or paths. Redirects are refused.
PROJECT_HEALTH_ORIGINS=
# Optional VERCEL_TOKEN and VERCEL_TEAM_ID in a private external environment.
# Otherwise connect Vercel in the phone UI; the token stays in gateway memory.
# Optional EXPO_PUSH_ACCESS_TOKEN if Expo push security is enabled.
# Push device tokens/outbox live in ~/.pocketsre/monitor-<port>.json, outside Git.
SENTRY_AUTH_TOKEN=
SENTRY_ORGANIZATION=
SENTRY_PROJECT=
