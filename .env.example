# Shared local-development defaults. Copy service-specific examples into .env files.
GATEWAY_PORT=4100
DEMO_SERVICE_URL=http://127.0.0.1:4200
DEMO_SERVICE_PORT=4200

# Use your computer's LAN IP when running the app on a physical phone.
EXPO_PUBLIC_GATEWAY_URL=http://192.168.1.10:4100

# A local file:// URI on the device. GGUF models are intentionally not committed.
EXPO_PUBLIC_MODEL_PATH=
