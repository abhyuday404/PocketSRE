# Use your development machine's LAN IP, not localhost, on a physical phone.
EXPO_PUBLIC_GATEWAY_URL=http://192.168.1.10:4100

# Optional file:// URI for a llama.rn-compatible quantized GGUF model on the phone.
# Without this value the app uses a clearly-labelled deterministic local fallback.
EXPO_PUBLIC_MODEL_PATH=

# cpu (portable default), gpu (OpenCL), or npu (experimental Hexagon).
# Hardware acceleration needs validation on the actual phone/model combination.
EXPO_PUBLIC_ACCELERATOR=cpu

# Optional: EAS project UUID for Expo push registration. Requires FCM credentials
# and a new native build; see docs/projects.md. This ID is public, not a token.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Set POCKETSRE_GOOGLE_SERVICES_FILE in the build environment to an absolute path
# OUTSIDE the repository. Do not put google-services.json or push keys in Git.
